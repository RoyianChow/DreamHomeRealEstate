# Dream Home Real Estate - environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Data source -------------------------------------------------------
# mock   = in-memory sample data (frontend development, no Oracle needed)
# oracle = live Oracle database via the server-side connection pool
DATA_SOURCE=mock

# --- Oracle connection (owned by Member 3 - API Integration Lead) ------
# Values below are names only. Real credentials go in .env.local.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1

# Optional: full client mode only (leave blank for Thin mode)
ORACLE_CLIENT_LIB_DIR=
